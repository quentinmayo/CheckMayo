# Copy to .env, set values, and never commit the resulting file.
PUBLIC_URL=http://localhost:8000
CHECKMAYO_MODE=controller
CHECKMAYO_SIGNUP=true
CHECKMAYO_ADMIN_EMAIL=admin@example.com
CHECKMAYO_ADMIN_PASSWORD=
CHECKMAYO_ENCRYPTION_KEY=
POSTGRES_PASSWORD=
# For the external-database override; PostgreSQL 16+ recommended.
DATABASE_URL=
# Optional: a verified, activated Buy Me a Coffee profile URL.
CHECKMAYO_DONATION_URL=
# OIDC_DISCOVERY_URL=https://identity.example.com/.well-known/openid-configuration
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# LDAP_URL=ldaps://directory.example.com:636
# LDAP_BIND_DN=
# LDAP_BIND_PASSWORD=
# LDAP_BASE_DN=
# LDAP_USER_FILTER=(uid={username})
# LDAP_CA_FILE=/run/certs/ldap-ca.pem
